# Per-user settings for the `hostinger` skill. Copy to ~/.hostinger/config.env
# (or point HOSTINGER_SKILL_CONFIG at another path) and fill in. Never commit your copy.
# Free-form notes about your setup (inventory, quirks, history) go in notes.md beside it.

# VPS SSH target (the srvNNNNNN.hstgr.cloud name shown in hPanel works).
VPS_HOST=srvNNNNNN.hstgr.cloud
VPS_USER=root
# A key that already has root access; used for audits and to authorize new deploy keys.
VPS_ADMIN_KEY=~/.ssh/id_ed25519

# Container registry owner: images are ghcr.io/$GH_OWNER/<app>.
GH_OWNER=your-github-user

# Custom domain for apps: <app>.$APP_DOMAIN, via a CNAME to $VPS_HOST.
# Leave empty to serve only <app>.$VPS_HOST.
APP_DOMAIN=example.com
DNS_TTL=3600

# Traefik on the VPS: entrypoint and ACME resolver names from its command line
# (defaults below match Hostinger's catalog Traefik).
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Optional: Hostinger API token (hPanel -> Profile -> API) for DNS automation.
# Prefer exporting HOSTINGER_API_TOKEN from a secret store over writing it here.
# HOSTINGER_API_TOKEN=
